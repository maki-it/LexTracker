# Copy to .env and adjust. All app settings use the APP_ prefix.

# development | production
APP_ENVIRONMENT=development
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
APP_SECRET_KEY=
# Comma-separated host names and origins the app is reached under.
APP_ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://zeit.example.de (needed when served via HTTPS behind a reverse proxy)
APP_CSRF_TRUSTED_ORIGINS=
# Set to false only if you open the app over plain HTTP (no reverse proxy with TLS).
APP_SECURE_COOKIES=true
# IP of your reverse proxy, so uvicorn trusts its X-Forwarded-* headers. "*" trusts everyone.
FORWARDED_ALLOW_IPS=127.0.0.1
# Number of uvicorn worker processes.
UVICORN_WORKERS=1
APP_TIME_ZONE=Europe/Berlin
APP_LOG_LEVEL=info

# Daily database backup: time and number of copies are set on the settings page. Without Docker
# they go to data/backups unless APP_BACKUP_DIR is set; in Docker to the /backups volume.
# APP_BACKUP_DIR=
# Docker only: where the app is published. 127.0.0.1:8000 if only a reverse proxy on the host needs it.
APP_PORT=8000

# Lexware Office Public API key. Better entered in the app (setup or Einstellungen), where it is stored
# encrypted. Used only while no key is set there.
APP_LEXWARE_API_KEY=

# Optional: admin account created on start if it does not exist yet (`manage.py ensure_superuser`).
# Without it, the first visit opens the setup, which creates the account in the browser.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
