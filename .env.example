# Django Configuration
APP_SECRET_KEY=change-me-to-a-random-secret-key-in-production
APP_DOMAIN=http://localhost:8000
APP_ENVIRONMENT=production
APP_LOGLEVEL=info

# Lexoffice API Configuration
LEXOFFICE_API_TOKEN=your-lexoffice-api-token-here

# Django Superuser (optional - only set if you want to auto-create on startup)
# Leave empty to skip automatic superuser creation
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=changeme
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Timezone
TZ=UTC

# Build arguments (optional)
VERSION=dev
REVISION=local
