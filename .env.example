# Copy to .env and adjust. All app settings use the APP_ prefix.

# development | production
APP_ENVIRONMENT=development
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
APP_SECRET_KEY=
# Comma-separated host names and origins the app is reached under.
APP_ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://zeit.example.de (needed when served via HTTPS behind a reverse proxy)
APP_CSRF_TRUSTED_ORIGINS=
# Set to false only if you open the app over plain HTTP (no reverse proxy with TLS).
APP_SECURE_COOKIES=true
# Strict-Transport-Security: seconds browsers must use HTTPS for this host. 0 sends no header. Set it
# (e.g. 31536000 = one year) once the app is reachable over HTTPS for good; browsers then refuse plain HTTP.
APP_HSTS_SECONDS=0
# IP of your reverse proxy, so uvicorn trusts its X-Forwarded-* headers. "*" trusts everyone.
FORWARDED_ALLOW_IPS=127.0.0.1
# Number of uvicorn worker processes.
UVICORN_WORKERS=1
APP_TIME_ZONE=Europe/Berlin
APP_LOG_LEVEL=info

# Daily database backup: time and number of copies are set on the settings page. Without Docker
# they go to data/backups unless APP_BACKUP_DIR is set; in Docker to the /backups volume.
# APP_BACKUP_DIR=
# Largest backup file that can be uploaded on the backups page, in MB (default 100).
# APP_BACKUP_UPLOAD_MAX_MB=100
# Docker only: version of the published image (e.g. 0.4.0 or 0.4); default: latest.
# LEXTRACKER_VERSION=latest
# Docker only: where the app is published. 127.0.0.1:8000 if only a reverse proxy on the host needs it.
APP_PORT=8000

# Lexware Office Public API key. Better entered in the app (setup or Einstellungen), where it is stored
# encrypted. Used only while no key is set there.
APP_LEXWARE_API_KEY=

# Optional sign-in with passkeys (fingerprint, face or PIN). Active once the domain is set. It is the host name the app
# is opened under, without https://, and it must not change later: passkeys belong to it.
# APP_PASSKEY_RP_ID=zeit.example.de
# Only for a trial over plain HTTP: the addresses with scheme and port (default: https://<APP_PASSKEY_RP_ID>).
# APP_PASSKEY_ORIGINS=http://localhost:8000

# Optional single sign-on with OpenID Connect, next to the login with password. Active once issuer, client ID
# and secret are set. Register the redirect URI https://<your address>/accounts/sso/callback/ at the provider.
# APP_OIDC_ISSUER=https://sso.example.de/realms/main
# APP_OIDC_CLIENT_ID=
# APP_OIDC_CLIENT_SECRET=
# Name on the login button.
# APP_OIDC_NAME=SSO
# APP_OIDC_SCOPES=openid email profile
# Create an employee account for people who sign in with SSO and have none (default: only existing users).
# APP_OIDC_CREATE_USERS=false
# Only with APP_OIDC_CREATE_USERS: e-mail domains that may get an account, comma-separated (default: all).
# APP_OIDC_ALLOWED_EMAIL_DOMAINS=
# Optional: admin account created on start if it does not exist yet (`manage.py ensure_superuser`).
# Without it, the first visit opens the setup, which creates the account in the browser.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
